#!/bin/bash
# SPDX-License-Identifier: LicenseRef-PolyForm-Shield-1.0.0
# Copyright 2026 Liu, Hsien-Ming (Louis Liu)
# Terminux srun wrapper。
# 安裝為 ~/.terminux/bin/_srun_wrapper；srun 是指向本檔的 symlink。
# 三模式攔截（interactive / step / direct）：
#   - 模式 1（--pty 在 argv）：interactive shell on compute node
#   - 模式 2（SLURM_JOB_ID 在 env 或 --jobid 在 argv）：step within allocation
#   - 模式 3（其餘）：direct submit + run（同 sbatch 語意）
# trace chain propagation + JSONL event=queue_submit；最後 exec 真 srun。
set -euo pipefail

source "$(dirname "$0")/_wrapper_lib.sh"

self_name="$(basename "$0")"

# 防止直接呼叫 _srun_wrapper（必須走 srun symlink）
if [[ "$self_name" == "_srun_wrapper" ]]; then
    echo "_srun_wrapper: must be invoked via 'srun' symlink" >&2
    exit 2
fi

# 找真正的 srun（用 device:inode 比對跳過自己）
real_cmd="$(terminux_find_real_tool "$self_name")" || {
    echo "$self_name: command not found" >&2
    exit 127
}

# 不在 Terminux 環境 → 透明 fall-through，不寫 JSONL、不改 argv
if [[ -z "${TERMINUX_TRACE_ROOT:-}" ]]; then
    exec "$real_cmd" "$@"
fi

# ── Terminux 環境 ──

# ── 模式判定 ──
# argv 掃描：--pty 一律優先（即便有 --jobid，--pty 仍歸為 interactive）。
# --jobid（=val 或空格 val 形式皆認）作為 step 候選；env 的 SLURM_JOB_ID 同效。
_mode="direct"
_has_pty=0
_has_jobid=0

for _arg in "$@"; do
    case "$_arg" in
        --pty)              _has_pty=1 ;;
        --jobid=*|--jobid)  _has_jobid=1 ;;
    esac
done

if [[ $_has_pty -eq 1 ]]; then
    _mode="interactive"
elif [[ $_has_jobid -eq 1 || -n "${SLURM_JOB_ID:-}" ]]; then
    _mode="step"
fi

# ── Trace chain ──
# advance PARENT/SELF（所有模式都做）
_terminux_advance_trace_chain

# TRACE_QUEUE：模式 1+3 新生 submit_<hex16>；模式 2 繼承 parent（避免切斷 sbatch 鏈接）
if [[ "$_mode" != "step" ]]; then
    export TERMINUX_TRACE_QUEUE="submit_$(head -c 16 /dev/urandom | xxd -p)"
fi

# ── argv 處理 ──
# Default：argv 不變；_terminux_inject_slurm_env 只在偵測到 --export 時覆寫
_TERMINUX_MODIFIED_ARGV=("$@")
_terminux_inject_slurm_env "$@"

# ── JSONL event ──
_terminux_log_queue_event "$self_name" "slurm" "$@"

exec "$real_cmd" "${_TERMINUX_MODIFIED_ARGV[@]}"
